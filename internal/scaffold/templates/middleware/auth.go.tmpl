package middleware

import (
	"net/http"
{{- if ne .AuthKind "session" }}
	"strings"
{{- end }}
{{- if ne .AuthKind "none" }}

	"{{ .ModulePath }}/auth"
{{- end }}
)
{{ if eq .AuthKind "none" }}
// RequireAuth wraps a handler so every protected route enforces the
// presence of both an X-Api-Key header and a Bearer token in the
// Authorization header. It only checks that both were sent — actual
// verification of the key/token values is TODO. Scaffold the app with
// -auth jwt|session|both to generate a real implementation backed by
// the auth package instead of this stub.
func RequireAuth(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		apiKey := r.Header.Get("X-Api-Key")
		if apiKey == "" {
			http.Error(w, "missing X-Api-Key header", http.StatusUnauthorized)
			return
		}

		token, ok := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer ")
		if !ok || token == "" {
			http.Error(w, "missing bearer token", http.StatusUnauthorized)
			return
		}

		// TODO: verify apiKey and token against real credentials.

		next(w, r)
	}
}
{{ else if eq .AuthKind "jwt" }}
// RequireAuth wraps a handler so every protected route requires a valid
// JWT bearer token (Authorization: Bearer <token>), verified via
// auth.VerifyJWT.
func RequireAuth(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		token, ok := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer ")
		if !ok || token == "" {
			http.Error(w, "missing bearer token", http.StatusUnauthorized)
			return
		}
		if _, err := auth.VerifyJWT(token); err != nil {
			http.Error(w, "invalid or expired token", http.StatusUnauthorized)
			return
		}
		next(w, r)
	}
}
{{ else if eq .AuthKind "session" }}
// RequireAuth wraps a handler so every protected route requires a valid
// session, identified by the auth.SessionCookieName cookie and looked
// up via auth.SessionFromRequest.
func RequireAuth(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		if _, ok := auth.SessionFromRequest(r); !ok {
			http.Error(w, "not logged in", http.StatusUnauthorized)
			return
		}
		next(w, r)
	}
}
{{ else }}
// RequireAuth wraps a handler so every protected route requires either a
// valid JWT bearer token (auth.VerifyJWT) or a valid session cookie
// (auth.SessionFromRequest) — so the same protected route serves both
// API clients (bearer token) and browser/UI clients (session cookie).
func RequireAuth(next http.HandlerFunc) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		if token, ok := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer "); ok && token != "" {
			if _, err := auth.VerifyJWT(token); err == nil {
				next(w, r)
				return
			}
		}
		if _, ok := auth.SessionFromRequest(r); ok {
			next(w, r)
			return
		}
		http.Error(w, "unauthorized", http.StatusUnauthorized)
	}
}
{{ end }}
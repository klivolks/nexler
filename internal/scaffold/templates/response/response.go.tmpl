// Package response provides helpers for writing a handler's result: JSON
// (wrapped in the {"data": ...}/{"error": "..."} envelope every
// nexler-generated handler uses for its API responses — see the openapi
// package, which documents the same shape) and HTML (rendering a
// module's on-disk templates, for routes scaffolded with
// `-response html`). See {{ .ModulePath }}/openapi.
{{- if .HasDB }}
//
// Error also auto-logs every 5xx it writes to the core database, via
// core.LogError — the same best-effort logging middleware.Recover already
// does for a recovered panic. 4xx responses (e.g. the standard 400 a
// handler writes on a decode/validation failure) are never logged: that's
// the client's fault, not worth it in the error log.
{{- end }}
package response

import (
	"bytes"
	"encoding/json"
	"fmt"
	"html/template"
	"net/http"
	"os"
	"path/filepath"
	"strings"
{{- if ne .AuthKind "none" }}

	"{{ .ModulePath }}/auth"
{{- end }}
{{- if .HasDB }}

	"{{ .ModulePath }}/core"
{{- end }}
)

// Envelope is the shape every JSON response is wrapped in. Exactly one of
// Data or Error is set.
type Envelope struct {
	Data  any    `json:"data,omitempty"`
	Error string `json:"error,omitempty"`
}

// JSON writes v wrapped as {"data": v} with the given status code.
func JSON(w http.ResponseWriter, status int, v any) {
	write(w, status, Envelope{Data: v})
}

// JSONRaw writes v directly (no {"data": ...} envelope) with the given
// status code — for routes with a response contract that predates the
// envelope convention (e.g. an existing non-Go client), where JSON's
// wrapping isn't an option. Prefer JSON for anything without that
// constraint, so the envelope stays the norm.
func JSONRaw(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	json.NewEncoder(w).Encode(v)
}

// Error writes message wrapped as {"error": message} with the given
// status code.
{{- if .HasDB }}
// A 5xx status also logs message to the core database via core.LogError,
// best-effort — a logging failure here is silently ignored rather than
// blocking the error response.
{{- end }}
func Error(w http.ResponseWriter, r *http.Request, status int, message string) {
{{- if .HasDB }}
	if status >= 500 {
		core.LogError(r.Context(), message, fmt.Sprintf("status %d", status), r.URL.Path)
	}
{{- end }}
	write(w, status, Envelope{Error: message})
}

func write(w http.ResponseWriter, status int, env Envelope) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	json.NewEncoder(w).Encode(env)
}

// htmlTemplatesDir is where per-module HTML content and layout templates
// live on disk, relative to the app's working directory. Unlike the
// embedded templates package (the built-in homepage/swagger/static
// assets, baked into the binary at build time), these are read straight
// off disk on every call so edits take effect without a rebuild.
const htmlTemplatesDir = "templates/html"

// htmlSharedDir is the module name resolveHTMLFile falls back to.
const htmlSharedDir = "shared"

// resolveHTMLFile returns the path to read for module's filename (a
// content file's "<name>.html", or "layout.html"): module's own copy if
// it has one, else the shared fallback under templates/html/shared — so
// e.g. a single layout.html can serve every module that doesn't need its
// own override. Errors naming both checked paths if neither exists.
func resolveHTMLFile(module, filename string) (string, error) {
	module = strings.Trim(module, "/\\")
	modPath := filepath.Join(htmlTemplatesDir, filepath.FromSlash(module))

	for {
		path := filepath.Join(modPath, filename)

		if _, err := os.Stat(path); err == nil {
			return path, nil
		}

		parent := filepath.Dir(modPath)

		if parent == modPath || parent == htmlTemplatesDir {
			break
		}

		modPath = parent
	}

	sharedPath := filepath.Join(htmlTemplatesDir, htmlSharedDir, filename)

	if _, err := os.Stat(sharedPath); err == nil {
		return sharedPath, nil
	}

	return "", fmt.Errorf(
		"HTML template %q not found in module hierarchy %q or shared directory",
		filename,
		module,
	)
}

// HTML renders module's content file (resolved by resolveHTMLFile: its own
// templates/html/<module>/<name>.html, or the shared
// templates/html/shared/<name>.html fallback) inside a layout.html
// (resolved the same way) and writes the result with status 200. Both
// files are generated once, at scaffold time — either by `nexler create
// <route> -response html` (see route.go's writeHTMLTemplates, and its
// -layout module/shared choice), or by `nexler create app -ui` for the
// built-in homepage, module "home" (see scaffold.go's writeAppUIHomepage).
// HTML itself only ever reads them: if neither a module-specific nor a
// shared copy exists (e.g. hand-deleted), it reports a clear error instead
// of silently recreating a placeholder over whatever was there.
//
// layout.html may also reference {{"{{.Header}}"}}, {{"{{.Sidebar}}"}}, and
// {{"{{.Footer}}"}} — each resolved and rendered the same way as content
// (module's own copy, walking up to shared), but unlike layout.html and
// the content file, these three are optional: a module with no
// header/sidebar/footer of its own (and none in any ancestor or shared)
// simply renders as an empty string there, rather than an error.
//
// data is available to the content template as {{"{{.Data}}"}}; title is
// available to content, layout, and every partial as {{"{{.Title}}"}}. The
// current request's authenticated subject (empty if unauthenticated, or if
// this app has no -auth) is available as {{"{{.Subject}}"}}, and the
// request path as {{"{{.Path}}"}}.
func HTML(w http.ResponseWriter, r *http.Request, module, name, title string, data any) {
	out, err := composeHTML(r, module, name, title, data)
	if err != nil {
		Error(w, r, http.StatusInternalServerError, err.Error())
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.WriteHeader(http.StatusOK)
	w.Write(out)
}

// HTMLError renders module's "error-content.html" (composed into the same
// layout/header/sidebar/footer as HTML) with the given status — for
// admin-page requests where an error should show as a styled page instead
// of Error's JSON envelope. data is available to error-content.html as
// {{"{{.Data}}"}}, same as HTML.
{{- if .HasDB }}
// A status >= 500 is logged the same way Error logs one.
{{- end }}
// If error-content.html itself can't be found/rendered (e.g. a module with
// no error page at all, nor a shared one), falls back to Error's plain
// JSON rather than risking a recursive rendering failure.
func HTMLError(w http.ResponseWriter, r *http.Request, module string, status int, title string, data any) {
	htmlErrorPage(w, r, module, "error-content", status, title, data)
}

// Unauthorised renders module's "unauthorised-content.html" with a 403 —
// for an authorization denial (e.g. a permission-check middleware), as
// distinct from plain unauthenticated access. Same fallback-to-JSON
// behavior as HTMLError if the page itself can't render.
func Unauthorised(w http.ResponseWriter, r *http.Request, module string, data any) {
	htmlErrorPage(w, r, module, "unauthorised-content", http.StatusForbidden, "Unauthorised", data)
}

// htmlErrorPage is HTMLError and Unauthorised's shared implementation:
// renders module's name+".html" (composed into the same layout/header/
// sidebar/footer as HTML) with the given status, for admin-page requests
// where an error should show as a styled page instead of Error's JSON
// envelope. data is available to the page as {{"{{.Data}}"}}, same as HTML.
{{- if .HasDB }}
// A status >= 500 is logged the same way Error logs one.
{{- end }}
// If the page itself can't be found/rendered (e.g. a module with no such
// page at all, nor a shared one), falls back to Error's plain JSON rather
// than risking a recursive rendering failure.
func htmlErrorPage(w http.ResponseWriter, r *http.Request, module, name string, status int, title string, data any) {
{{- if .HasDB }}
	if status >= 500 {
		core.LogError(r.Context(), title, fmt.Sprintf("status %d", status), r.URL.Path)
	}
{{- end }}
	out, err := composeHTML(r, module, name, title, data)
	if err != nil {
		write(w, status, Envelope{Error: title})
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.WriteHeader(status)
	w.Write(out)
}

// composeHTML resolves and renders module's name+".html" content file
// inside its layout.html (plus the optional header/sidebar/footer
// partials — see HTML's doc comment), returning the composed bytes
// without writing anything to a response. Shared by HTML (always writes
// status 200) and HTMLError/Unauthorised (write the caller's status) so
// they never drift in how they build a page.
func composeHTML(r *http.Request, module, name, title string, data any) ([]byte, error) {
	contentPath, err := resolveHTMLFile(module, name+".html")
	if err != nil {
		return nil, err
	}
	contentSrc, err := os.ReadFile(contentPath)
	if err != nil {
		return nil, fmt.Errorf("reading %s: %w", contentPath, err)
	}
	layoutPath, err := resolveHTMLFile(module, "layout.html")
	if err != nil {
		return nil, err
	}
	layoutSrc, err := os.ReadFile(layoutPath)
	if err != nil {
		return nil, fmt.Errorf("reading %s: %w", layoutPath, err)
	}

{{- if ne .AuthKind "none" }}
	subject, _ := auth.Subject(r)
{{- else }}
	subject := ""
{{- end }}
	page := struct {
		Title   string
		Data    any
		Subject string
		Path    string
	}{title, data, subject, r.URL.Path}

	contentTmpl, err := template.New(name).Parse(string(contentSrc))
	if err != nil {
		return nil, fmt.Errorf("parsing %s: %w", contentPath, err)
	}
	var content bytes.Buffer
	if err := contentTmpl.Execute(&content, page); err != nil {
		return nil, fmt.Errorf("rendering %s: %w", contentPath, err)
	}

	header, err := renderOptionalPartial(module, "header.html", page)
	if err != nil {
		return nil, err
	}
	sidebar, err := renderOptionalPartial(module, "sidebar.html", page)
	if err != nil {
		return nil, err
	}
	footer, err := renderOptionalPartial(module, "footer.html", page)
	if err != nil {
		return nil, err
	}

	layoutTmpl, err := template.New("layout").Parse(string(layoutSrc))
	if err != nil {
		return nil, fmt.Errorf("parsing %s: %w", layoutPath, err)
	}
	var out bytes.Buffer
	if err := layoutTmpl.Execute(&out, struct {
		Title                            string
		Content, Header, Sidebar, Footer template.HTML
	}{title, template.HTML(content.String()), header, sidebar, footer}); err != nil {
		return nil, fmt.Errorf("rendering %s: %w", layoutPath, err)
	}

	return out.Bytes(), nil
}

// renderOptionalPartial resolves and renders module's filename (walking up
// to shared, same as resolveHTMLFile always has) with page as its
// template data, for the optional header/sidebar/footer partials HTML
// composes into layout.html. Unlike resolveHTMLFile's other two callers
// (layout.html and the content file, both required), a partial that
// doesn't exist anywhere in the hierarchy is not an error — it just
// renders as empty, so modules without their own header/sidebar/footer
// are unaffected.
func renderOptionalPartial(module, filename string, page any) (template.HTML, error) {
	path, err := resolveHTMLFile(module, filename)
	if err != nil {
		return "", nil
	}
	src, err := os.ReadFile(path)
	if err != nil {
		return "", fmt.Errorf("reading %s: %w", path, err)
	}
	tmpl, err := template.New(filename).Parse(string(src))
	if err != nil {
		return "", fmt.Errorf("parsing %s: %w", path, err)
	}
	var buf bytes.Buffer
	if err := tmpl.Execute(&buf, page); err != nil {
		return "", fmt.Errorf("rendering %s: %w", path, err)
	}
	return template.HTML(buf.String()), nil
}

// nexler:response (do not remove this marker) — nexler anchors future
// additions to this package here.

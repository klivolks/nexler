# {{ .AppName }} runtime configuration — see config/config.go.
{{ .EnvPrefix }}_HOST=
{{ .EnvPrefix }}_PORT=8080
{{ .EnvPrefix }}_SWAGGER_ENABLED=true
{{- if or (eq .AuthKind "jwt") (eq .AuthKind "both") }}
{{ .EnvPrefix }}_JWT_SECRET={{ .JWTSecret }}
{{- end }}
{{- if .HasDB }}

# Database connections — see db/db.go. "core" is this app's conventional
# default connection (store/ packages reach for it via
# db.{{ .CoreDBAccessor }}("core") unless told otherwise){{ if .CoreDBDSN }}.{{ else }} — fill in its DSN below.{{ end }}
# Add more connections either by hand (list another name here, then a
# _TYPE ({{ .DBTypesCSV }}) and _DSN per name) or via `nexler db add <name>
# -type <type>`, which can also enable a driver type you didn't originally
# select here. Example:
#   {{ .EnvPrefix }}_DB_CONNECTIONS=core,analytics
#   {{ .EnvPrefix }}_DB_ANALYTICS_TYPE=postgres
#   {{ .EnvPrefix }}_DB_ANALYTICS_DSN=postgres://user:pass@localhost:5432/appdb
{{ .EnvPrefix }}_DB_CONNECTIONS=core
{{ .EnvPrefix }}_DB_CORE_TYPE={{ .CoreDB }}
{{ .EnvPrefix }}_DB_CORE_DSN={{ .CoreDBDSN }}
{{- end }}

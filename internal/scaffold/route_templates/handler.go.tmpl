package {{ .PkgName }}

import (
	"net/http"

	"{{ .ModulePath }}/middleware"
	{{ .Alias }}models "{{ .ModulePath }}/models/{{ .RelDirSlash }}"
	"{{ .ModulePath }}/openapi"
	"{{ .ModulePath }}/request"
	"{{ .ModulePath }}/response"
)
{{ range .Methods }}
// Handle{{ $.Name }}{{ .VerbTitle }} handles {{ .Verb }} {{ $.Route }}.
func Handle{{ $.Name }}{{ .VerbTitle }}(w http.ResponseWriter, r *http.Request) {
	var req {{ $.Alias }}models.{{ .VerbTitle }}{{ $.Name }}Request
	if err := {{ .DecodeCall }}; err != nil {
		response.Error(w, r, http.StatusBadRequest, err.Error())
		return
	}
{{- if $.HasPathParams }}
	if err := request.DecodePath(r, &req, {{ $.PathParamArgs }}); err != nil {
		response.Error(w, r, http.StatusBadRequest, err.Error())
		return
	}
{{- end }}

{{- if $.HasServiceRef }}
	// TODO: call the {{ $.ServicePkgName }} service package (see
	// {{ $.ServiceImportPath }}) with req, and build a real
	// {{ $.Alias }}models.{{ .VerbTitle }}{{ $.Name }}Response.
{{- else if $.HasService }}
	// TODO: call {{ $.PkgName }}'s service with req, and build a real
	// {{ $.Alias }}models.{{ .VerbTitle }}{{ $.Name }}Response.
{{- else }}
	// TODO: implement {{ $.PkgName }}'s request handling directly here —
	// no service package was generated for this route (re-run
	// `nexler create {{ $.Route }} -module ... -service <name>` to add
	// one later, or write services/{{ $.RelDirSlash }} by hand) — and
	// build a real {{ $.Alias }}models.{{ .VerbTitle }}{{ $.Name }}Response.
{{- end }}
	resp := {{ $.Alias }}models.{{ .VerbTitle }}{{ $.Name }}Response{}

{{- if $.HTMLResponse }}
	response.HTML(w, r, "{{ $.RelDirSlash }}", "{{ .HTMLContentName }}", "{{ $.Name }}", resp)
{{- else if $.RawResponse }}
	response.JSONRaw(w, http.StatusOK, resp)
{{- else }}
	response.JSON(w, http.StatusOK, resp)
{{- end }}
}
{{ end }}
// nexler:handlers (do not remove this marker) — `nexler create <route>`
// adds new methods' handler functions above this line when adding to an
// existing route.

// Register wires this package's route onto mux for every selected method,
// plus a blanket 200 OK for OPTIONS, and registers each method's
// documentation (including real request/response field names, reflected
// from the models package) with the openapi package so /openapi.json
// picks it up automatically. Uses Go's method-aware ServeMux patterns
// ("METHOD /path", Go 1.22+) — hitting the path with an unregistered
// method gets an automatic 405 from net/http. Called once
{{- if .Protected }}
// from routes/protected/protected.go. Individual methods below wrap
// themselves in middleware.RequireAuth independently — a later
// `nexler create` on this route can add public methods alongside these.
{{- else }}
// from routes/public/public.go. Individual methods below wrap
// themselves in middleware.RequireAuth independently — a later
// `nexler create` on this route can add protected methods alongside these.
{{- end }}
func Register(mux *http.ServeMux) {
	mux.HandleFunc("OPTIONS {{ .Route }}", middleware.HandleOptions)
{{- range .Methods }}
	mux.HandleFunc("{{ .Verb }} {{ $.Route }}", {{ .RegisterExpr }})
	openapi.Register(openapi.Operation{
		Method:      "{{ .Verb }}",
		Path:        "{{ $.Route }}",
		OperationID: "{{ .OperationID }}",
		Summary:     "{{ .Verb }} {{ $.Route }}",
		Protected:   {{ .Protected }},
		Tags:        []string{"{{ $.Module }}"},
		ReqType:     {{ $.Alias }}models.{{ .VerbTitle }}{{ $.Name }}Request{},
{{- if .ReqContentType }}
		ReqContentType: "{{ .ReqContentType }}",
{{- end }}
		RespType: {{ $.Alias }}models.{{ .VerbTitle }}{{ $.Name }}Response{},
{{- if $.HTMLResponse }}
		RespContentType: "text/html",
{{- end }}
{{- if $.RawResponse }}
		RespUnwrapped: true,
{{- end }}
	})
{{- end }}
	// nexler:register (do not remove this marker)
}
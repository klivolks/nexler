// Package kpass is a client for klivolks' kpass permission-check service.
// Check calls POST {KPASS_URL}/permission/check/ and returns kpass's full
// response — including UserRole/UserType — so callers can write their own
// conditions on top of it (e.g. restricting which data a given role/level
// can fetch), not just a plain yes/no; Allowed is the separate, simple
// helper for the common "is this a plain ALLOW" case. Authorise calls GET
// {KPASS_URL}/api/v1/authorise to resolve a one-time login/auth code (from
// whatever flow the frontend used) into the calling user's identity. Fill
// in KPASS_URL, KPASS_CLIENT_ID, and KPASS_API_SECRET in .env before use
// (added by `nexler init kpass`).
package kpass

import (
	"context"
	"fmt"
	"net/http"
	"net/url"
	"os"
	"strings"
{{- if or .HasJWT .HasSession }}

	"{{ .ModulePath }}/auth"
{{- end }}

	"{{ .ModulePath }}/apiclient"
)

// Access is kpass's permission verdict for one Check call. ALLOW/DENY are
// the values documented today; compare Result.Access directly rather than
// assuming these are the only two, since kpass may add more later.
type Access string

const (
	AccessAllow Access = "ALLOW"
	AccessDeny  Access = "DENY"
)

// Result is kpass's raw /permission/check/ response.
type Result struct {
	Status   string `json:"status"`            // "success" or "error"
	Message  string `json:"message,omitempty"` // set when Status is "error"
	Access   Access `json:"access"`
	UserRole string `json:"user_role"`
	UserType string `json:"user_type"`
}

// Check calls kpass's POST {KPASS_URL}/permission/check/ for userID's
// access to resource (e.g. "myapp.users.create"), and returns kpass's
// full response — including UserRole/UserType — so callers can write
// their own conditions on top of it (e.g. restricting which data a given
// role/level can fetch), not just a plain yes/no. See Allowed for the
// common "is this a plain ALLOW" case; Check itself stays the one place
// that talks to kpass, kept separate on purpose so it's never forced
// through a bool-only helper.
//
// extra adds further fields to the request payload beyond
// user_id/resource, for whatever kpass's API grows to accept later.
func Check(ctx context.Context, userID, resource string, extra map[string]any) (*Result, error) {
	base := os.Getenv("KPASS_URL")
	if base == "" {
		return nil, fmt.Errorf("kpass: KPASS_URL is not set")
	}

	payload := map[string]any{"user_id": userID, "resource": resource}
	for k, v := range extra {
		payload[k] = v
	}
	headers := map[string]string{
		"X-Client-Id":  os.Getenv("KPASS_CLIENT_ID"),
		"X-Api-Secret": os.Getenv("KPASS_API_SECRET"),
	}

	resp, err := apiclient.Post(ctx, strings.TrimRight(base, "/")+"/permission/check/", headers, payload)
	if err != nil {
		return nil, fmt.Errorf("kpass: calling permission/check: %w", err)
	}
	var result Result
	if err := resp.JSON(&result); err != nil {
		return nil, fmt.Errorf("kpass: decoding response: %w", err)
	}
	if result.Status == "error" {
		return &result, fmt.Errorf("kpass: %s", result.Message)
	}
	return &result, nil
}

// Allowed reports whether result is a plain ALLOW — the common case for a
// simple auth gate, kept separate from Check so callers needing more
// (UserRole/UserType-based conditions) call Check directly instead of
// being forced through a bool.
func Allowed(result *Result) bool {
	return result != nil && result.Access == AccessAllow
}

// AuthoriseResult is kpass's GET /api/v1/authorise response — the identity
// of the user a one-time authorization code was issued for, by whatever
// login/auth flow the frontend used (kpass's own, or something else).
type AuthoriseResult struct {
	UserId   string `json:"userId"`
	UserType string `json:"userType"`
	UserName string `json:"userName"`
	UserRole string `json:"userRole"`
	OrgId    string `json:"orgId"`
}

// Authorise calls kpass's GET {KPASS_URL}/api/v1/authorise to resolve code
// (a one-time authorization code issued by whatever login/auth flow the
// frontend used) into the calling user's identity. KPASS_CLIENT_ID is
// always sent; KPASS_API_SECRET is sent only if set, since kpass treats it
// as optional for this endpoint.
func Authorise(ctx context.Context, code string) (*AuthoriseResult, error) {
	base := os.Getenv("KPASS_URL")
	if base == "" {
		return nil, fmt.Errorf("kpass: KPASS_URL is not set")
	}

	q := url.Values{}
	q.Set("code", code)
	q.Set("client_id", os.Getenv("KPASS_CLIENT_ID"))
	if secret := os.Getenv("KPASS_API_SECRET"); secret != "" {
		q.Set("api_secret", secret)
	}
	endpoint := strings.TrimRight(base, "/") + "/api/v1/authorise?" + q.Encode()

	resp, err := apiclient.Get(ctx, endpoint, nil)
	if err != nil {
		return nil, fmt.Errorf("kpass: calling api/v1/authorise: %w", err)
	}
	// This endpoint's response has no in-body error signal (unlike Check's
	// Status field) — an invalid/expired code must be caught via HTTP
	// status here, or a non-2xx body would silently decode into a
	// zero-valued AuthoriseResult instead of erroring.
	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("kpass: api/v1/authorise returned %d: %s", resp.StatusCode, string(resp.Body))
	}
	var result AuthoriseResult
	if err := resp.JSON(&result); err != nil {
		return nil, fmt.Errorf("kpass: decoding response: %w", err)
	}
	return &result, nil
}
{{- if or .HasJWT .HasSession }}

// UserIDFromRequest extracts r's authenticated subject — the same
// subject middleware.RequireAuth already verified and attached to r's
// context via auth.ContextWithSubject — for passing as Check's userID.
// ok is false if r was never authenticated (e.g. a public route, or one
// not wrapped in middleware.RequireAuth).
func UserIDFromRequest(r *http.Request) (userID string, ok bool) {
	return auth.Subject(r)
}
{{- end }}

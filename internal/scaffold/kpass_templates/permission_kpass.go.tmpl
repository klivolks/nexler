// This file wires middleware.PermissionCheck (see middleware/task.go) to
// a real permission check, generated by `nexler init kpass` once this app
// already has the Task Registry (middleware/task.go). Edit
// services/kpass/kpass.go's CheckAccess if you need different behavior
// (caching, role overrides, logging) — this file itself is nexler-owned
// infrastructure, same as middleware/task.go, not a hand-edit point.
package middleware

import (
	"context"

	kpasssvc "{{ .ModulePath }}/services/kpass"
)

func init() {
	PermissionCheck = func(ctx context.Context, subject, action string) (bool, error) {
		return kpasssvc.CheckAccess(ctx, subject, action, nil)
	}
}

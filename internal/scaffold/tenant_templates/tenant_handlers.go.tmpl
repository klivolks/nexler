// Package tenants is the admin API for tenant_orgs — list and delete,
// generated by `nexler init tenant`. Hand-authored (not routed through
// the generic nexler create <route> machinery, unlike a business route),
// same "one self-contained file" precedent as handlers/admin/users and
// handlers/admin/services.
//
// Every handler below wraps in middleware.RegisterTask, requireAuth
// true — that confirms the caller is *authenticated*, not that they're
// *authorized* to delete a tenant. RegisterTask's PermissionCheck hook is
// nil until something sets it, so until then any authenticated caller may
// delete a tenant. Run `nexler init kpass` to have it wired to a real
// permission check (services/kpass.CheckAccess, e.g. for the
// "admin.tenants.delete" action) automatically — permission enforcement
// is expected to be layered on separately, per app, not assumed by
// nexler.
package tenants

import (
	"net/http"

	"{{ .ModulePath }}/middleware"
	"{{ .ModulePath }}/openapi"
	"{{ .ModulePath }}/request"
	"{{ .ModulePath }}/response"
	"{{ .ModulePath }}/tenant"
)

// TenantOrgSummary is one tenant_orgs record, as returned below.
type TenantOrgSummary struct {
	ID        string         `json:"id"`
	Name      string         `json:"name"`
	Settings  map[string]any `json:"settings,omitempty"`
	Status    string         `json:"status"`
	CreatedAt string         `json:"created_at"`
	UpdatedAt string         `json:"updated_at"`
}

func toTenantOrgSummary(t tenant.TenantOrg) TenantOrgSummary {
	return TenantOrgSummary{
		ID:        t.ID,
		Name:      t.Name,
		Settings:  t.Settings,
		Status:    t.Status,
		CreatedAt: t.CreatedAt.Format("2006-01-02T15:04:05Z07:00"),
		UpdatedAt: t.UpdatedAt.Format("2006-01-02T15:04:05Z07:00"),
	}
}

// GetTenantsRequest is the (empty — query-parameters-only) request for
// GET /admin/tenants.
type GetTenantsRequest struct{}

// GetTenantsResponse is the response payload for GET /admin/tenants.
type GetTenantsResponse struct {
	Tenants []TenantOrgSummary `json:"tenants"`
}

// HandleTenantsGet handles GET /admin/tenants — lists every tenant_orgs
// record. No pagination this release.
func HandleTenantsGet(w http.ResponseWriter, r *http.Request) {
	var req GetTenantsRequest
	if err := request.DecodeQuery(r, &req); err != nil {
		response.Error(w, r, http.StatusBadRequest, err.Error())
		return
	}
	orgs, err := tenant.ListTenantOrgs(r.Context())
	if err != nil {
		response.Error(w, r, http.StatusInternalServerError, err.Error())
		return
	}
	out := make([]TenantOrgSummary, len(orgs))
	for i, t := range orgs {
		out[i] = toTenantOrgSummary(t)
	}
	response.JSON(w, http.StatusOK, GetTenantsResponse{Tenants: out})
}

// DeleteTenantRequest is the (path-parameter-only) request for DELETE
// /admin/tenants/{id}.
type DeleteTenantRequest struct {
	Id string `json:"id"`
}

// DeleteTenantResponse is the (empty) response payload for DELETE
// /admin/tenants/{id}.
type DeleteTenantResponse struct{}

// HandleTenantDelete handles DELETE /admin/tenants/{id} — see
// tenant.DeleteTenantOrg: this is a real, hard delete. There is no undo.
func HandleTenantDelete(w http.ResponseWriter, r *http.Request) {
	var req DeleteTenantRequest
	if err := request.DecodePath(r, &req, "id"); err != nil {
		response.Error(w, r, http.StatusBadRequest, err.Error())
		return
	}
	if err := tenant.DeleteTenantOrg(r.Context(), req.Id); err != nil {
		response.Error(w, r, http.StatusInternalServerError, err.Error())
		return
	}
	response.JSON(w, http.StatusOK, DeleteTenantResponse{})
}

// Register wires this package's admin tenant-management routes onto
// mux — see the package doc comment re: RegisterTask's RequireAuth only
// confirming authentication, not authorization — and documents them with
// the openapi package so /openapi.json picks them up automatically.
// Called from routes/protected/protected.go (wired automatically by
// `nexler init tenant`).
func Register(mux *http.ServeMux) {
	mux.HandleFunc("GET /admin/tenants", middleware.RegisterTask("admin.tenants.list", true, GetTenantsRequest{}, GetTenantsResponse{})(HandleTenantsGet))
	openapi.Register(openapi.Operation{
		Method:      "GET",
		Path:        "/admin/tenants",
		OperationID: "listTenants",
		Summary:     "List all tenant_orgs records",
		Protected:   true,
		Tags:        []string{"admin-tenants"},
		ReqType:     GetTenantsRequest{},
		RespType:    GetTenantsResponse{},
	})

	mux.HandleFunc("DELETE /admin/tenants/{id}", middleware.RegisterTask("admin.tenants.delete", true, DeleteTenantRequest{}, DeleteTenantResponse{}, "id")(HandleTenantDelete))
	openapi.Register(openapi.Operation{
		Method:      "DELETE",
		Path:        "/admin/tenants/{id}",
		OperationID: "deleteTenant",
		Summary:     "Permanently delete a tenant organization — no undo",
		Protected:   true,
		Tags:        []string{"admin-tenants"},
		ReqType:     DeleteTenantRequest{},
		RespType:    DeleteTenantResponse{},
	})
}
